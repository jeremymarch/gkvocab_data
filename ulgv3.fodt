         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> Ἆρ&apos; ἔστι ταῦτα δὶς τόσ&apos; ἐξ ἁπλῶν κακά;</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
        </table:table-row>

        <table:table-row>
