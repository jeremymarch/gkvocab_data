         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> κρατοῦντ&apos; ἐν Ἄρει· νῦν δ&apos; αὖ φρενὸς οἰοβώτας</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents">613-614</text:p>
