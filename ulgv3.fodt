         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents">Κἄπειτ&apos; ἐπειδὴ τοῦδ&apos; ἐλώφησεν φόνου,</text:p>
         </table:table-cell>
