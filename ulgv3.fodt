      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">old age <text:span text:style-name="T2">(For declension see H&amp;Q Appendix, p. 592.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

