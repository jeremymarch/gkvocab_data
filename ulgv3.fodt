      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">γηθέω, γηθήσω, ἐγήθησα, γέγηθα, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">rejoice; <text:span text:style-name="T2">(perf. with present meaning)</text:span> rejoice, be glad</text:p>
      </table:table-cell>
    </table:table-row>

