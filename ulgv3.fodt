      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">bend of the arm, elbow; bend (of a river); headland; cove; glen</text:p>
      </table:table-cell>
    </table:table-row>

