      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">Kalliope <text:span text:style-name="T2">(one of the Muses)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

