    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀθῡμέω, —, ἠθμησα, — —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">be disheartened, lose heart; be sore afraid</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">δρᾱσείω, —, —, —, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">have a mind to do (desiderative form of δρω)</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">εὔφημος, εὔφημον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">keeping a holy silence; pious; auspicious</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">θροέω, θροήσω, ἐθρόησα, —, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">cry aloud</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">κάτοιδα</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">know well, understand</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">μαλάσσω, μαλάξω, ἐμάλαξα, —, —, ἐμαλάχθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">make soft; <text:span text:style-name="T2">(pass.)</text:span> be softened, relent</text:p>
      </table:table-cell>
