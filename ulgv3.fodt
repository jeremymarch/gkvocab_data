         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> ἐκ χειρὸς αὐτοῖς ποιμνίων ἐπιστάταις.</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
        </table:table-row>

        <table:table-row>
