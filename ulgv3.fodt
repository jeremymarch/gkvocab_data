        <text:p text:style-name="GlossTableLemma">ἄκρος, ἄκρᾱ, ἄκρον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">furthest, at the furthest point</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
