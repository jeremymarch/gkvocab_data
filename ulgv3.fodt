         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents">ἔτι μέ ποτ&apos; ἀνύσειν τὸν ἀπότροπον ἀΐδηλον Ἅιδαν.</text:p>
         </table:table-cell>
