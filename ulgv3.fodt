    <text:p text:style-name="Standard">
δευτέραν εἰς βασιλέως ἐννόμου ἢ πολεμικοῦ καὶ ἀρχικοῦ, τρίτην εἰς πολιτικοῦ ἤ τινος οἰκονομικοῦ ἢ χρηματιστικοῦ, τετάρτην εἰς φιλοπόνου &lt;ἢ&gt; γυμναστικοῦ ἢ περὶ σώματος ἴασίν τινος ἐσομένου, πέμπτην μαντικὸν βίον ἤ τινα τελεστικὸν ἕξουσαν· <text:span text:style-name="T1">248e</text:span> ἕκτῃ ποιητικὸς ἢ τῶν περὶ μίμησίν τις ἄλλος ἁρμόσει, ἑβδόμῃ δημιουργικὸς ἢ γεωργικός,</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
      <table:table-column table:style-name="GlossTable.B"/>
      <table:table-column table:style-name="GlossTable.C"/>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἁρμόζω/ἁρμόττω, ἁρμόσω, ἥρμοσα, ἥρμοκα, ἥρμοσμαι, ἡρμόσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">fit together, join; prepare; regulate, govern; arrange according to laws of harmony, tune</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀρχικός, ἀρχική, ἀρχικόν</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">of or for rule, royal; skilled in government</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">γεωργικός, γεωργική, γεωργικόν</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">agricultural; skilled in farming</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">γυμναστικός, γυμναστική, γυμναστικόν</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">fond of or skilled in exercise; athletic</text:p>
      </table:table-cell>
    </table:table-row>

