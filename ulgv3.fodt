    <text:p text:style-name="PageBreakStyle"/>


            
    <text:p text:style-name="Standard">
διετρίβομεν, οὐκ οἶδ&apos; ὅντινα τρόπον ἐρωτικός. γέγραφε γὰρ δὴ ὁ Λυσίας πειρώμενόν τινα τῶν καλῶν, οὐχ ὑπ&apos; ἐραστοῦ δέ, ἀλλ&apos; αὐτὸ δὴ τοῦτο καὶ κεκόμψευται· λέγει γὰρ ὡς χαριστέον μὴ ἐρῶντι μᾶλλον ἢ ἐρῶντι.<text:span text:style-name="T1">ΣΩ.</text:span>  Ὢ γενναῖος. εἴθε γράψειεν ὡς χρὴ πένητι μᾶλλον ἢ πλουσίῳ, καὶ πρεσβυτέρῳ ἢ νεωτέρῳ, καὶ ὅσα ἄλλα ἐμοί τε πρόσεστι καὶ τοῖς πολλοῖς ἡμῶν· <text:span text:style-name="T1">227d</text:span> ἦ γὰρ ἂν ἀστεῖοι καὶ δημωφελεῖς εἶεν οἱ λόγοι. ἔγωγ&apos; οὖν οὕτως ἐπιτεθύμηκα ἀκοῦσαι, ὥστ&apos; ἐὰν βαδίζων ποιῇ τὸν περίπατον</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
      <table:table-column table:style-name="GlossTable.B"/>
      <table:table-column table:style-name="GlossTable.C"/>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀστεῖος, ἀστείᾱ, ἀστεῖον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">of the town; urbane, elegant, refined</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">βαδίζω, βαδιοῦμαι, ἐβάδισα, βεβάδικα, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">go slowly, walk, proceed</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">γενναῖος, γενναίᾱ, γενναῖον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">noble; good; genuine</text:p>
      </table:table-cell>
