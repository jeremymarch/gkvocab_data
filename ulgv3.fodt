          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> κληθεὶς ἀφορμᾷς πεῖραν οὔτε του κλύων</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents">290</text:p>
         </table:table-cell>
        </table:table-row>

        <table:table-row>
