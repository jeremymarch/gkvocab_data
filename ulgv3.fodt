      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(adv.)</text:span> at some time; (after interrogative or relative) [what] in the world; [what]ever</text:p>
      </table:table-cell>
    </table:table-row>

