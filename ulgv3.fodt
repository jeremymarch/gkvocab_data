      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(ὀδύνῃσι = ὀδύναις)</text:span> pain</text:p>
      </table:table-cell>
    </table:table-row>

