        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(adv.)</text:span> from afar; from long ago</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
