        <text:p text:style-name="GlossTableLemma">ἀναγκάζω, ἀναγκάσω, ἠνάγκασα, ἠνάγκακα, ἠνάγκασμαι, ἠναγκάσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">force, compel</text:p>
      </table:table-cell>
    </table:table-row>

