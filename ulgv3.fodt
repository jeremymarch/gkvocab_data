        <text:p text:style-name="GlossTableDef">brilliance, brightness</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">μέμφομαι, μέμψομαι, ἐμεμψάμην, —, —, ἐμέμφθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">blame, find fault with <text:span text:style-name="T2">(+ dat. or acc.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">μῖσος, μσους, τό</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">hatred; thing of hatred</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">παραλω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">loose and take off, detach; part from; disable, enfeeble</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">παραυτίκα</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(adv.)</text:span> immediately, forthwith, straightaway</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">προγιγνώσκω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">know, perceive, learn, or understand beforehand; prognosticate; judge beforehand</text:p>
      </table:table-cell>
    </table:table-row>

    </table:table>
    <text:p text:style-name="PageBreakStyle"/>


            
    <text:p text:style-name="Standard">
καὶ ἀπὸ τῶν παρόντων δεινῶν ἀπάγειν τὴν γνώμην. <text:span text:style-name="T1">2</text:span> οἱ δὲ δημοσίᾳ μὲν τοῖς λόγοις ἀνεπείθοντο καὶ οὔτε πρὸς τοὺς Λακεδαιμονίους ἔτι ἔπεμπον ἔς τε τὸν πόλεμον μᾶλλον ὥρμηντο, ἰδίᾳ δὲ τοῖς παθήμασιν ἐλυποῦντο, ὁ μὲν δῆμος ὅτι ἀπ&apos; ἐλασσόνων ὁρμώμενος ἐστέρητο καὶ τούτων, οἱ δὲ δυνατοὶ καλὰ κτήματα κατὰ τὴν χώραν οἰκοδομίαις τε καὶ πολυτελέσι κατασκευαῖς ἀπολωλεκότες, τὸ δὲ μέγιστον, πόλεμον ἀντ&apos; εἰρήνης ἔχοντες. <text:span text:style-name="T1">3</text:span> οὐ μέντοι πρότερόν γε οἱ ξύμπαντες ἐπαύσαντο ἐν ὀργῇ ἔχοντες αὐτὸν πρὶν ἐζημίωσαν χρήμασιν. <text:span text:style-name="T1">4</text:span> ὕστερον δ&apos; αὖθις οὐ πολλῷ, ὅπερ φιλεῖ ὅμιλος ποιεῖν, στρατηγὸν εἵλοντο καὶ πάντα τὰ πράγματα ἐπέτρεψαν, ὧν μὲν περὶ τὰ οἰκεῖα ἕκαστος ἤλγει ἀμβλύτεροι ἤδη ὄντες, ὧν δὲ ἡ ξύμπασα πόλις προσεδεῖτο πλείστου ἄξιον νομίζοντες εἶναι. <text:span text:style-name="T1">5</text:span> ὅσον τε γὰρ χρόνον</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
      <table:table-column table:style-name="GlossTable.B"/>
      <table:table-column table:style-name="GlossTable.C"/>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀλγέω, ἀλγήσω, ἤλγησα, ἤλγηκα, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">feel pain, suffer; grieve</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀμβλύς, ἀμβλεῖα, ἀμβλύ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">blunt, dull; having lost keenness of feeling; spiritless</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀναπείθω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(intensified compound of πείθω)</text:span> persuade, convince (used especially of changing someone’s opinion)</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐπιτρέπω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">give over to, entrust</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ζημιόω, ζημιώσω, ἐζημίωσα, ἐζημίωκα, ἐζημίωμαι, ἐζημιώθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">cause loss <text:span text:style-name="T2">or</text:span> damage; penalize, punish; fine</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">κτῆμα, κτήματος, τό</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">piece of property, possession</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">οἰκοδομίᾱ, οἰκοδομίᾱς, ἡ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">building</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ὅμῑλος, ὁμλου, ὁ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">crowd</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">πάθημα, παθήματος, τό</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">experience, incident, suffering</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">πολυτελής, πολυτελές</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">costly, extravagant</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">προσδέομαι</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">need or require besides <text:span text:style-name="T2">(+ gen.)</text:span>; to beg or ask <text:span text:style-name="T2">(someone, in acc.)</text:span> for <text:span text:style-name="T2">(something, in gen.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">στερέω, στερήσω, ἐστέρησα, ἐστέρηκα, ἐστέρημαι, ἐστερήθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">deprive <text:span text:style-name="T2">(someone, in acc.)</text:span> of <text:span text:style-name="T2">(something, in gen.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    </table:table>
    <text:p text:style-name="PageBreakStyle"/>


            
    <text:p text:style-name="Standard">
προύστη τῆς πόλεως ἐν τῇ εἰρήνῃ, μετρίως ἐξηγεῖτο καὶ ἀσφαλῶς διεφύλαξεν αὐτήν, καὶ ἐγένετο ἐπ&apos; ἐκείνου μεγίστη, ἐπειδή τε ὁ πόλεμος κατέστη, ὁ δὲ φαίνεται καὶ ἐν τούτῳ προγνοὺς τὴν δύναμιν. <text:span text:style-name="T1">6</text:span> ἐπεβίω δὲ δύο ἔτη καὶ ἓξ μῆνας· καὶ ἐπειδὴ ἀπέθανεν, ἐπὶ πλέον ἔτι ἐγνώσθη ἡ πρόνοια αὐτοῦ ἡ ἐς τὸν πόλεμον. <text:span text:style-name="T1">7</text:span> ὁ μὲν γὰρ ἡσυχάζοντάς τε καὶ τὸ ναυτικὸν θεραπεύοντας καὶ ἀρχὴν μὴ ἐπικτωμένους ἐν τῷ πολέμῳ μηδὲ τῇ πόλει κινδυνεύοντας ἔφη περιέσεσθαι· οἱ δὲ ταῦτά τε πάντα ἐς τοὐναντίον ἔπραξαν καὶ ἄλλα ἔξω τοῦ πολέμου δοκοῦντα εἶναι κατὰ τὰς ἰδίας φιλοτιμίας καὶ ἴδια κέρδη κακῶς ἔς τε σφᾶς αὐτοὺς καὶ τοὺς ξυμμάχους ἐπολίτευσαν, ἃ κατορθούμενα μὲν τοῖς ἰδιώταις τιμὴ καὶ ὠφελία μᾶλλον ἦν, σφαλέντα δὲ τῇ πόλει ἐς τὸν πόλεμον βλάβη καθίστατο. <text:span text:style-name="T1">8</text:span> αἴτιον δ&apos; ἦν ὅτι ἐκεῖνος μὲν δυνατὸς ὢν τῷ τε ἀξιώματι καὶ τῇ γνώμῃ χρημάτων τε διαφανῶς ἀδωρότατος γενόμενος κατεῖχε τὸ πλῆθος ἐλευθέρως, καὶ οὐκ ἤγετο μᾶλλον ὑπ&apos; αὐτοῦ ἢ αὐτὸς ἦγε, διὰ τὸ μὴ κτώμενος ἐξ οὐ προσηκόντων τὴν δύναμιν πρὸς ἡδονήν τι λέγειν, ἀλλ&apos; ἔχων ἐπ&apos; ἀξιώσει καὶ πρὸς ὀργήν τι ἀντειπεῖν.</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
      <table:table-column table:style-name="GlossTable.B"/>
      <table:table-column table:style-name="GlossTable.C"/>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἄδωρος, ἄδωρον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">without gifts; giving no gifts</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀντιλέγω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">speak against, gainsay, contradict <text:span text:style-name="T2">(+ dat.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀξίωμα, ἀξιώματος, τό</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">honor, prestige; illustrious birth</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">διαφανής, διαφανές</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">clear, transparent</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">διαφυλάττω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">guard carefully</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐπιβιόω, —, ἐπεβίων, —, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">live over into, survive</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐπικτάομαι</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">acquire in addition</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">κατορθόω, κατορθώσω, κατώρθωσα, κατώρθωκα, κατώρθωμαι, κατωρθώθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">set upright; keep straight; succeed</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">περίειμι</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">be around; be superior, excel; be spared, survive</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
