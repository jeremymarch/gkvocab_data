      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">of or for a sophist, like a sophist, sophistical</text:p>
      </table:table-cell>
    </table:table-row>

