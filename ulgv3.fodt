        <text:p text:style-name="GlossTableLemma">πέρᾱ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(adv.)</text:span> beyond; further; longer <text:span text:style-name="T2">(+ gen.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">συνδιαγιγνώσκω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">join with in decreeing</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">τυραννίς, τυραννίδος, ἡ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">monarchy; despotic rule, tyranny</text:p>
      </table:table-cell>
    </table:table-row>

    </table:table>
    <text:p text:style-name="PageBreakStyle"/>


            
    <text:p text:style-name="Standard">
πάντων ἐλπίδος κρεῖσσον γεγενημένον. καὶ δι&apos; αὐτὴν οἶδ&apos; ὅτι μέρος τι μᾶλλον ἔτι μισοῦμαι, οὐ δικαίως, εἰ μὴ καὶ ὅταν παρὰ λόγον τι εὖ πράξητε ἐμοὶ ἀναθήσετε. <text:span text:style-name="T1">2</text:span> φέρειν δὲ χρὴ τά τε δαιμόνια ἀναγκαίως τά τε ἀπὸ τῶν πολεμίων ἀνδρείως· ταῦτα γὰρ ἐν ἔθει τῇδε τῇ πόλει πρότερόν τε ἦν νῦν τε μὴ ἐν ὑμῖν κωλυθῇ. <text:span text:style-name="T1">3</text:span> γνῶτε δὲ ὄνομα μέγιστον αὐτὴν ἔχουσαν ἐν ἅπασιν ἀνθρώποις διὰ τὸ ταῖς ξυμφοραῖς μὴ εἴκειν, πλεῖστα δὲ σώματα καὶ πόνους ἀνηλωκέναι πολέμῳ, καὶ δύναμιν μεγίστην δὴ μέχρι τοῦδε κεκτημένην, ἧς ἐς ἀΐδιον τοῖς ἐπιγιγνομένοις, ἢν καὶ νῦν ὑπενδῶμέν ποτε</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
      <table:table-column table:style-name="GlossTable.B"/>
      <table:table-column table:style-name="GlossTable.C"/>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀΐδιος, ἀΐδιον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">imperishable, indestructible</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
