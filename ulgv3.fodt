      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">δαιμόνιος, δαιμονίᾱ, δαιμόνιον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">pertaining to a δαίμων, strange; <text:span text:style-name="T2"> as neut. subst.:</text:span> spirit</text:p>
      </table:table-cell>
    </table:table-row>

