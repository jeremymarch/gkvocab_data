      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ὀργιάζω, ὀργιάσω, ὤργισα, —, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">celebrate secret rites, honor or worship with secret rites</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
