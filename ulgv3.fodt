        <text:p text:style-name="GlossTableLemma">εἰσβάλλω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">throw into; come upon, make an assault upon</text:p>
      </table:table-cell>
    </table:table-row>

