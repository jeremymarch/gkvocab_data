    <text:p text:style-name="Standard">
δέοντα ἔτη ἱερωμένης καὶ Αἰνησίου ἐφόρου ἐν Σπάρτῃ καὶ Πυθοδώρου ἔτι δύο μῆνας ἄρχοντος Ἀθηναίοις, μετὰ τὴν ἐν Ποτειδαίᾳ μάχην μηνὶ ἕκτῳ καὶ ἅμα ἦρι ἀρχομένῳ Θηβαίων ἄνδρες ὀλίγῳ πλείους τριακοσίων (ἡγοῦντο δὲ αὐτῶν βοιωταρχοῦντες Πυθάγγελός τε ὁ Φυλείδου καὶ Διέμπορος ὁ Ὀνητορίδου) ἐσῆλθον περὶ πρῶτον ὕπνον ξὺν ὅπλοις ἐς Πλάταιαν τῆς Βοιωτίας</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
      <table:table-column table:style-name="GlossTable.B"/>
      <table:table-column table:style-name="GlossTable.C"/>

    <table:table-row table:style-name="GlossTableRow">
