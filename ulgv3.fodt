        <text:p text:style-name="GlossTableDef">Gorgias <text:span text:style-name="T2">(of Leontini) (sophist and rhetorician)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
