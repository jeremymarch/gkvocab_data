      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀνοίγνῡμι/ἀνοίγω, ἀνοίξω, ἀνέῳξα, ἀνέῳχα/ἀνέῳγα, ἀνέῳγμαι, ἀνεῴχθην</text:p>
      </table:table-cell>
