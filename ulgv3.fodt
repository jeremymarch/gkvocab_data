         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> λείας ἁπάσας καὶ κατηναρισμένας</text:p>
         </table:table-cell>
