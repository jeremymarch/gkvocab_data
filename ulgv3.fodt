      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">care for <text:span text:style-name="T2">(+ gen. or inf.)</text:span>; practice</text:p>
