      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">a sleeping together</text:p>
      </table:table-cell>
    </table:table-row>

    </table:table>
    <text:p text:style-name="PageBreakStyle"/>


            
    <text:p text:style-name="Standard">
ὁ δὲ ὁμόζυξ αὖ μετὰ τοῦ ἡνιόχου πρὸς ταῦτα μετ&apos; αἰδοῦς καὶ λόγου ἀντιτείνει. ἐὰν μὲν δὴ οὖν εἰς τεταγμένην τε δίαιταν καὶ φιλοσοφίαν νικήσῃ τὰ βελτίω τῆς διανοίας ἀγαγόντα, μακάριον μὲν <text:span text:style-name="T1">256b</text:span> καὶ ὁμονοητικὸν τὸν ἐνθάδε βίον διάγουσιν, ἐγκρατεῖς αὑτῶν καὶ κόσμιοι ὄντες, δουλωσάμενοι μὲν ᾧ κακία ψυχῆς ἐνεγίγνετο, ἐλευθερώσαντες δὲ ᾧ ἀρετή· τελευτήσαντες δὲ δὴ ὑπόπτεροι καὶ ἐλαφροὶ γεγονότες τῶν τριῶν παλαισμάτων τῶν ὡς ἀληθῶς Ὀλυμπιακῶν ἓν νενικήκασιν, οὗ μεῖζον ἀγαθὸν οὔτε σωφροσύνη ἀνθρωπίνη οὔτε θεία μανία δυνατὴ πορίσαι ἀνθρώπῳ.</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
      <table:table-column table:style-name="GlossTable.B"/>
      <table:table-column table:style-name="GlossTable.C"/>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">διάγω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">pass, spend (life); live</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">δίαιτα, διαίτης, ἡ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">way of life; regimen</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">δουλόω, δουλώσω, ἐδούλωσα, δεδούλωκα, δεδούλωμαι, ἐδουλώθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">enslave</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐγγίγνομαι</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">happen; appear; be born in, be innate</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐγκρατής, ἐγκρατές</text:p>
