        <text:p text:style-name="GlossTableLemma">ἐγκωμιάζω, ἐγκωμιάσω, ἐνεκωμίασα, ἐγκεκωμίακα, ἐγκεκωμίασμαι, ἐνεκωμιάσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">praise, extol</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
