        <text:p text:style-name="GlossTableLemma">παρέρχομαι</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">pass by, go beside; surpass, be superior; arrive at, go into; come forward (to speak)</text:p>
      </table:table-cell>
