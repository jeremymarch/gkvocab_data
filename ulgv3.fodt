      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">θαρρέω, θαρρήσω, ἐθάρρησα, τεθάρρηκα, τεθάρρημαι, ἐθαρρήθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
