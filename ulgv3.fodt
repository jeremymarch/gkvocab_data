      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">Ἀφροδτη, Ἀφροδτης, ἡ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">Aphrodite</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">Διόνῡσος, Διονσου, ὁ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">Dionysos</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἔθω, —, —, εἴωθα, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">be accustomed <text:span text:style-name="T2">(present only as participle, otherwise perfect has present meaning)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐξαλλαγή, ἑξαλλαγῆς, ἡ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">complete change; alteration</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐπίπνοια, ἐπιπνοίᾱς, ἡ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">breathing upon; inspiration</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">μανικός, μανική, μανικόν</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">of or for madness, mad</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">νόμιμος, (νομίμη,) νόμιμον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">customary; lawful, rightful</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">νόσημα, νοσήματος, τό</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">sickness, disease</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ποιητικός, ποιητική, ποιητικόν</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">capable of making, creative, productive; poetic</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">τελεστικός, τελεστική, τελεστικόν</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">connected with rites of mystic initiation</text:p>
      </table:table-cell>
    </table:table-row>

    </table:table>
    <text:p text:style-name="PageBreakStyle"/>


            
    <text:p text:style-name="Standard">
ἀπεικάζοντες, ἴσως μὲν ἀληθοῦς τινος ἐφαπτόμενοι, τάχα δ&apos; ἂν καὶ ἄλλοσε παραφερόμενοι, κεράσαντες οὐ παντάπασιν ἀπίθανον λόγον, <text:span text:style-name="T1">265c</text:span> μυθικόν τινα ὕμνον προσεπαίσαμεν μετρίως τε καὶ εὐφήμως τὸν ἐμόν τε καὶ σὸν δεσπότην Ἔρωτα, ὦ Φαῖδρε, καλῶν παίδων ἔφορον.<text:span text:style-name="T1">ΦΑΙ.</text:span>  Καὶ μάλα ἔμοιγε οὐκ ἀηδῶς ἀκοῦσαι.</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
      <table:table-column table:style-name="GlossTable.B"/>
      <table:table-column table:style-name="GlossTable.C"/>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀηδής, ἀηδές</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">distasteful, unpleasant</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἄλλοσε</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(adv.)</text:span> to another place</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀπεικάζω, ἀπεικάσω, ἀπῄκασα, —, ἀπῄκασμαι, ἀπῃκάσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">liken, compare <text:span text:style-name="T2">(something, in acc.)</text:span> with <text:span text:style-name="T2">(something, in dat.)</text:span>; guess, conjecture; represent; express by a comparison</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀπίθανος, ἀπίθανον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">incredible; unpersuasive, unconvincing</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">δεσπότης, δεσπότου, ὁ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">master, lord</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">εὔφημος, εὔφημον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">keeping a holy silence; pious; auspicious</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐφάπτω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">bind to; <text:span text:style-name="T2">(mid.)</text:span> lay hold of; attain to <text:span text:style-name="T2">(+ gen.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἔφορος, ἐφόρου, ὁ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">overseer, guardian, ruler; Ephor<text:span text:style-name="T2"> (Spartan magistrate)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">κεράννῡμι/κεραννύω, κεράσω, ἐκέρασα, —, κέκρᾱμαι, ἐκρθην/ἐκεράσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">mix <text:span text:style-name="T2">(usually wine with water)</text:span>, mingle, blend</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">μέτριος, (μετρίᾱ,) μέτριον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">moderate, measured</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">μῡθικός, μῡθική, μῡθικόν</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">mythical, legendary</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">παραφέρω</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">bring to one&apos;s side, serve; bring forward, allege; carry past or beyond</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">προσπαίζω, προσπαίξομαι, προσέπαισα/προσέπαιξα, —, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">make fun of <text:span text:style-name="T2">(+ dat. or acc.)</text:span>; sing <text:span text:style-name="T2">(something, in acc.)</text:span> in praise of <text:span text:style-name="T2">(someone, in acc.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ὕμνος, ὕμνου, ὁ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">song; hymn, festive song <text:span text:style-name="T2">or</text:span> ode</text:p>
      </table:table-cell>
    </table:table-row>

    </table:table>
    <text:p text:style-name="PageBreakStyle"/>


            
    <text:p text:style-name="Standard">
<text:span text:style-name="T1">ΣΩ.</text:span> Τόδε τοίνυν αὐτόθεν λάβωμεν, ὡς ἀπὸ τοῦ ψέγειν πρὸς τὸ ἐπαινεῖν ἔσχεν ὁ λόγος μεταβῆναι.<text:span text:style-name="T1">ΦΑΙ.</text:span>  Πῶς δὴ οὖν αὐτὸ λέγεις;<text:span text:style-name="T1">ΣΩ.</text:span>  Ἐμοὶ μὲν φαίνεται τὰ μὲν ἄλλα τῷ ὄντι παιδιᾷ πεπαῖσθαι· τούτων δέ τινων ἐκ τύχης ῥηθέντων δυοῖν εἰδοῖν, εἰ αὐτοῖν τὴν δύναμιν τέχνῃ λαβεῖν δύναιτό τις, οὐκ ἄχαρι. <text:span text:style-name="T1">265d</text:span> <text:span text:style-name="T1">ΦΑΙ.</text:span> Τίνων δή;<text:span text:style-name="T1">ΣΩ.</text:span>  Εἰς μίαν τε ἰδέαν συνορῶντα ἄγειν τὰ πολλαχῇ διεσπαρμένα, ἵνα ἕκαστον ὁριζόμενος δῆλον ποιῇ περὶ οὗ ἂν ἀεὶ διδάσκειν ἐθέλῃ. ὥσπερ τὰ νυνδὴ περὶ Ἔρωτος—ὃ ἔστιν ὁρισθέν—εἴτ&apos; εὖ εἴτε κακῶς ἐλέχθη, τὸ γοῦν σαφὲς καὶ τὸ αὐτὸ αὑτῷ ὁμολογούμενον διὰ ταῦτα ἔσχεν εἰπεῖν ὁ λόγος.<text:span text:style-name="T1">ΦΑΙ.</text:span>  Τὸ δ&apos; ἕτερον δὴ εἶδος τί λέγεις, ὦ Σώκρατες; <text:span text:style-name="T1">265e</text:span> <text:span text:style-name="T1">ΣΩ.</text:span> Τὸ πάλιν κατ&apos; εἴδη δύνασθαι διατέμνειν κατ&apos; ἄρθρα ᾗ πέφυκεν, καὶ μὴ ἐπιχειρεῖν καταγνύναι μέρος μηδέν, κακοῦ μαγείρου τρόπῳ χρώμενον·</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
