         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> Ἅπαν μαθήσῃ τοὔργον, ὡς κοινωνὸς ὤν.</text:p>
