      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">Οὐρανίᾱ, Οὐρανίᾱς, ἡ</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">Ourania <text:span text:style-name="T2">(one of the Muses)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

