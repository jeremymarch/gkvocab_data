      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">put to, close, apply; hand over; attribute <text:span text:style-name="T2">(+ acc.)</text:span> to <text:span text:style-name="T2">(+ dat.)</text:span>; add (to)</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
