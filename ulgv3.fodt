        <text:p text:style-name="GlossTableLemma">παραπλέω, παραπλεύσομαι/παραπλευσοῦμαι, παρέπλευσα, παραπέπλευκα, παραπέπλευσμαι, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">sail by, sail past; sail along the coast</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
