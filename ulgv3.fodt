        <text:p text:style-name="GlossTableLemma">διασπείρω, διασπερῶ, διέσπειρα, —, διέσπαρμαι, διεσπάρην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">scatter, spread around</text:p>
