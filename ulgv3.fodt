      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">κατανέμω, κατανεμῶ, κατένειμα, κατανενέμηκα, κατανενέμημαι, κατενεμήθην</text:p>
      </table:table-cell>
