         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> Ὁρῶ δέ τοί νιν, κἄστιν, ὡς ἐμοὶ δοκεῖ,</text:p>
