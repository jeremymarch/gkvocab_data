    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">σχολάζω, σχολάσω, ἐσχόλασα, ἑσχόλακα, ἐσχόλασμαι, ἐσχολάσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">have leisure, be at leisure; devote one&apos;s time to <text:span text:style-name="T2">(something, in dat.)</text:span>; study</text:p>
