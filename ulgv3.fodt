        <text:p text:style-name="GlossTableLemma">ἀκόλαστος, ἀκόλαστον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">wanton, intemperate, licentious</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
