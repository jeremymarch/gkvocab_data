        <table:table-row>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents">μνήμην προσεῖναι, τερπνὸν εἴ τί που πάθῃ·</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
        </table:table-row>

        <table:table-row>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> χάρις χάριν γάρ ἐστιν ἡ τίκτουσ&apos; ἀεί·</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
        </table:table-row>

        <table:table-row>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> ὅτου δ&apos; ἀπορρεῖ μνῆστις εὖ πεπονθότος,</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
        </table:table-row>

        <table:table-row>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> οὐκ ἂν λέγοιτ&apos; ἔθ&apos; οὗτος εὐγενὴς ἀνήρ.</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
        </table:table-row>

        <table:table-row>
