         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> καὶ νῦν κατ&apos; οἴκους συνδέτους αἰκίζεται.</text:p>
