         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> ὥστ&apos; ἐν τοιοῖσδε χεῖρας αἱμάξαι βοτοῖς·</text:p>
