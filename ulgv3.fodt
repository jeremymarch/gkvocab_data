         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> τοὺς ζῶντας αὖ δεσμοῖσι συνδήσας βοῶν</text:p>
