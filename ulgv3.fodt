        <text:p text:style-name="GlossTableDef">hold the office of Boiotarch <text:span text:style-name="T2">(a magistrate of the Boeotian league)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
