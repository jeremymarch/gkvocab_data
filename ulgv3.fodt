        <text:p text:style-name="GlossTableLemma">ἐπαΐω, —, —, —, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">give ear to <text:span text:style-name="T2">(+ gen.)</text:span>; understand, be wise</text:p>
      </table:table-cell>
