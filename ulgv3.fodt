      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">to bring forth; <text:span text:style-name="T2">(mid.)</text:span> choose, prefer <text:span text:style-name="T2">(+ acc. or infin.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

