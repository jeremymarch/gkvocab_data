         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> Κἀγὼ &apos;πιπλήσσω καὶ λέγω· «Τί χρῆμα δρᾷς,</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
