        <text:p text:style-name="GlossTableDef">join in prayer (with) <text:span text:style-name="T2">(+ dat.)</text:span>; include <text:span text:style-name="T2">(someone, in dat.)</text:span> in prayer</text:p>
      </table:table-cell>
