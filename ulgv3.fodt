        <text:p text:style-name="GlossTableDef">be strong; rule (over) <text:span text:style-name="T2">(+ gen.)</text:span>; rule among <text:span text:style-name="T2">(+ dat.)</text:span>; conquer <text:span text:style-name="T2">(+ acc.)</text:span></text:p>
      </table:table-cell>
