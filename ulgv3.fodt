      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">alter, remodel; <text:span text:style-name="T2">(mid.)</text:span> pretend to <text:span text:style-name="T2"> (+ gen.)</text:span></text:p>
