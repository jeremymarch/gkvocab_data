        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(adj. with adverbial force)</text:span> willingly, purposefully</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
