         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> κἀγὼ &apos;θελοντὴς τῷδ&apos; ὑπεζύγην πόνῳ.</text:p>
         </table:table-cell>
