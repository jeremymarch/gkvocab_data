      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐπαντλέω, ἐπαντλήσω, ἐπήντλησα, ἐπήντληκα, ἐπήντλημαι, ἐπηντλήθην</text:p>
      </table:table-cell>
