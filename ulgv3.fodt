      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">cast <text:span text:style-name="T2">(something, in acc.)</text:span> upon <text:span text:style-name="T2">(something, in dat.)</text:span>; <text:span text:style-name="T2">(mid.)</text:span> put <text:span text:style-name="T2">(something, in acc.)</text:span> on <text:span text:style-name="T2">(something, in dat.)</text:span> for oneself; jostle, trample</text:p>
      </table:table-cell>
    </table:table-row>

