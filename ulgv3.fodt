        <text:p text:style-name="GlossTableLemma">ἀρέσκω, ἀρέσω, ἤρεσα, ἀρήρεκα, —, ἠρέσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">please, satisfy</text:p>
      </table:table-cell>
    </table:table-row>

