      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">love, be fond of; be contented with <text:span text:style-name="T2">(+ dat.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

