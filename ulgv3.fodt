         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> Ἐφθαρμένας γὰρ ἀρτίως εὑρίσκομεν</text:p>
         </table:table-cell>
