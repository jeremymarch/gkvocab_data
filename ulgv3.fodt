         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> τὰ δ&apos; ἄλλ&apos; ὅμοιος, καὶ γένοι&apos; ἂν οὐ κακός.</text:p>
