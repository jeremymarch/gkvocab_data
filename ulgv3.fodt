        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">χρονίζω, χρονιῶ, ἐχρόνισα, κεχρόνικα, κεχρόνισμαι, ἐχρονίσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">spend time, last, continue</text:p>
      </table:table-cell>
    </table:table-row>

    </table:table>
    <text:p text:style-name="PageBreakStyle"/>


            
    <text:p text:style-name="Standard">
ὃν ἵμερον Ζεὺς Γανυμήδους ἐρῶν ὠνόμασε, πολλὴ φερομένη πρὸς τὸν ἐραστήν, ἡ μὲν εἰς αὐτὸν ἔδυ, ἡ δ&apos; ἀπομεστουμένου ἔξω ἀπορρεῖ· καὶ οἷον πνεῦμα ἤ τις ἠχὼ ἀπὸ λείων τε καὶ στερεῶν ἁλλομένη πάλιν ὅθεν ὡρμήθη φέρεται, οὕτω τὸ τοῦ κάλλους ῥεῦμα πάλιν εἰς τὸν καλὸν διὰ τῶν ὀμμάτων ἰόν, ᾗ πέφυκεν ἐπὶ τὴν ψυχὴν ἰέναι ἀφικόμενον καὶ ἀναπτερῶσαν, <text:span text:style-name="T1">255d</text:span> τὰς διόδους τῶν πτερῶν ἄρδει τε καὶ ὥρμησε πτεροφυεῖν τε καὶ τὴν τοῦ ἐρωμένου αὖ ψυχὴν ἔρωτος ἐνέπλησεν. ἐρᾷ μὲν οὖν, ὅτου δὲ ἀπορεῖ· καὶ οὔθ&apos; ὅτι πέπονθεν οἶδεν οὐδ&apos; ἔχει φράσαι, ἀλλ&apos; οἷον ἀπ&apos; ἄλλου ὀφθαλμίας ἀπολελαυκὼς πρόφασιν εἰπεῖν οὐκ ἔχει,</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
      <table:table-column table:style-name="GlossTable.B"/>
      <table:table-column table:style-name="GlossTable.C"/>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἅλλομαι, ἁλοῦμαι, ἡλόμην/ἡλάμην, —, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">spring, leap, bound</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀναπτερόω, ἀναπτερώσω, ἀνεπτέρωσα, ἀνεπτέρωκα, ἀνεπτέρωμαι, ἀνεπτερώθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">raise the wings; excite</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀπολαύω, ἀπολαύσομαι, ἀπέλαυσα, ἀπολέλαυκα, ἀπολέλαυσμαι, ἀπελαύσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">have enjoyment of, benefit or profit from <text:span text:style-name="T2">(+ gen.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀπομεστόομαι, —, —, —, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">be filled to the brim</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἀπορρέω, ἀπορρυήσομαι, —, ἀπερρύηκα, —, ἀπερρύην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">flow or stream forth; flow away</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
