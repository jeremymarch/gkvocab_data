    </table:table>
    <text:p text:style-name="PageBreakStyle"/>


            
    <text:p text:style-name="Standard">
ἐπαίνου ἀναγκάζει τυγχάνειν· ὥστε πολὺ μᾶλλον ἐλεεῖν τοῖς ἐρωμένοις ἢ ζηλοῦν αὐτοὺς προσήκει. ἐὰν δέ μοι πείθῃ, πρῶτον μὲν οὐ τὴν παροῦσαν ἡδονὴν θεραπεύων συνέσομαί σοι, ἀλλὰ καὶ <text:span text:style-name="T1">233c</text:span> τὴν μέλλουσαν ὠφελίαν ἔσεσθαι, οὐχ ὑπ&apos; ἔρωτος ἡττώμενος ἀλλ&apos; ἐμαυτοῦ κρατῶν, οὐδὲ διὰ σμικρὰ ἰσχυρὰν ἔχθραν ἀναιρούμενος ἀλλὰ διὰ μεγάλα βραδέως ὀλίγην ὀργὴν ποιούμενος, τῶν μὲν ἀκουσίων συγγνώμην ἔχων, τὰ δὲ ἑκούσια πειρώμενος ἀποτρέπειν· ταῦτα γάρ ἐστι φιλίας πολὺν χρόνον ἐσομένης τεκμήρια. εἰ δ&apos; ἄρα σοι τοῦτο παρέστηκεν, ὡς οὐχ οἷόν τε ἰσχυρὰν φιλίαν γενέσθαι ἐὰν μή τις ἐρῶν τυγχάνῃ, <text:span text:style-name="T1">233d</text:span> ἐνθυμεῖσθαι χρὴ ὅτι οὔτ&apos; ἂν τοὺς ὑεῖς περὶ πολλοῦ ἐποιούμεθα οὔτ&apos; ἂν τοὺς πατέρας καὶ τὰς μητέρας, οὔτ&apos; ἂν πιστοὺς φίλους ἐκεκτήμεθα,</text:p>

    <text:p text:style-name="P1"/>
    <text:p text:style-name="P1"/>
    <table:table table:name="Table1" table:style-name="GlossTable">
      <table:table-column table:style-name="GlossTable.A"/>
