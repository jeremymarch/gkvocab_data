      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">wagon; wagon-chassis; wagon-load</text:p>
      </table:table-cell>
    </table:table-row>

