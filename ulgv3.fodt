      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">τυραννικός, τυραννική, τυραννικόν</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">of or for a tyrant, of or for a king</text:p>
      </table:table-cell>
    </table:table-row>

