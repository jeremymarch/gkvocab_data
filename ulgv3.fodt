    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">πλεῖος, πλείη, πλεῖον/πλέον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">full <text:span text:style-name="T2">(+ gen.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
