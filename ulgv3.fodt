      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(adv.)</text:span> from near at hand, hard by</text:p>
      </table:table-cell>
