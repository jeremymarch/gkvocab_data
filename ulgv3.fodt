          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> βίᾳ ξυναρπασθεῖσαν Ἀργείων ὕπο</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
        </table:table-row>

        <table:table-row>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"> ξὺν παιδὶ τῷ σῷ δουλίαν ἕξειν τροφήν.</text:p>
         </table:table-cell>
         <table:table-cell table:style-name="VerseTable.A1" office:value-type="string">
          <text:p text:style-name="Table_20_Contents"></text:p>
