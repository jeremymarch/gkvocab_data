        <text:p text:style-name="GlossTableDef">distribute, allot</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8"></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">κατασκευάζω, κατασκευάσω, κατεσκεύασα, κατεσκεύακα, κατεσκεύασμαι, κατεσκευάσθην</text:p>
      </table:table-cell>
