      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">κατακοσμέω, κατακοσμήσω, κατεκόσμησα, κατακεκόσμηκα, κατακεκόσμημαι, κατεκοσμήθην</text:p>
      </table:table-cell>
