      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">be unfortunate; meet with refusal, fail to attain <text:span text:style-name="T2">(+ gen.)</text:span></text:p>
