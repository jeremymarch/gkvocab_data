        <text:p text:style-name="GlossTableLemma">προσαρμόζω/προσαρμόττω, προσαρμόσω, προσήρμοσα, —, προσήρμοσμαι, προσηρμόσθην</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">attach closely, fit, adapt; agree with, suit</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
