      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">have relations or dealings with <text:span text:style-name="T2">(+ dat.)</text:span>; come to, be in</text:p>
