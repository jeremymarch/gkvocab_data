      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">ἐνδιατρβω, ἐνδιατρψω, ἐνδιέτρῑψα, ἐνδιατέτρῑφα, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">spend, consume</text:p>
