      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(adv.)</text:span> with pain and toil, with difficulty</text:p>
      </table:table-cell>
    </table:table-row>

