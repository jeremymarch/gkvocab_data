      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">μεταμέλει, μεταμελήσει, μετεμέλησε(ν), —, —, —</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef"><text:span text:style-name="T2">(impersonal verb)</text:span> there is regret for <text:span text:style-name="T2">(someone, in dat.)</text:span> for <text:span text:style-name="T2">(something, in gen.)</text:span></text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableLemma">οἰκεῖος, οἰκείᾱ, οἰκεῖον</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="GlossTableDef">of or in the house, domestic; of one’s kin, kindred; one&apos;s own,</text:p>
      </table:table-cell>
    </table:table-row>

    <table:table-row table:style-name="GlossTableRow">
      <table:table-cell table:style-name="GlossTableCell" office:value-type="string">
        <text:p text:style-name="P8">→</text:p>
      </table:table-cell>
